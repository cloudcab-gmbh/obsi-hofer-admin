# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Supabase (PROJ-1: Dataverse-Sync-Service)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supabase (PROJ-6: Passkey-Login) — Browser-Client braucht NEXT_PUBLIC_-
# Variablen, da die WebAuthn-Zeremonie im Browser laufen muss. Gleiche
# Werte wie oben (Publishable Key ist bewusst oeffentlich).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared secret Power Automate sends in the x-api-key header
SYNC_API_KEY=

# TEMPORÄR: schickt zusätzlich zu Fehler-Alerts auch bei jedem erfolgreichen
# naechtlichen Sync eine Zusammenfassungs-Mail (Vercel Hobby zeigt Logs nur
# fuer die letzten 30 Minuten). Einfach entfernen, sobald nicht mehr noetig.
CRON_NOTIFY_ON_SUCCESS=true

# Dataverse Web API access (only needed to run: npm run backfill:dataverse)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
DATAVERSE_URL=https://your-org.crmXX.dynamics.com/
