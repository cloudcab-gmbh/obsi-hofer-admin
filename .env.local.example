# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Auth.js (PROJ-1: Entra-ID-Login mit Rollen)
# AUTH_SECRET: zufälliger String zum Signieren der Session-Cookies, z.B.
# per `npx auth secret` erzeugen.
AUTH_SECRET=
# Kanonische URL dieser App (für Redirects, u.a. beim federated Logout).
# Lokal: http://localhost:3000
AUTH_URL=http://localhost:3000
# Aus der App-Registrierung im OBSI-Hofer-Firmen-Tenant (Entra Admin Center
# → App registrations), siehe PROJ-1 Implementation Notes für die genauen
# Einrichtungsschritte.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Dataverse Web API (PROJ-2: Dataverse-Web-API-Anbindung)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
DATAVERSE_URL=https://your-org.crmXX.dynamics.com/

# Sync-Freigabe (PROJ-5) — ruft den bestehenden Endpoint im separaten
# Kundenportal-Repo auf, gleicher Wert wie dort CRON_SECRET.
KUNDENPORTAL_SYNC_URL=https://obsi-hoferkundenportal.vercel.app/api/cron/sync-dataverse
KUNDENPORTAL_CRON_SECRET=
# Sicherheitsschalter: erst auf "true" setzen, wenn im Kundenportal der
# Firma-Filter (dort PROJ-12) deployt ist. Ein älterer Endpoint ignoriert den
# firmaId-Parameter und würde ALLE Firmen synchronisieren. Solange der Wert
# fehlt oder nicht "true" ist, bleibt der Sync-Button deaktiviert.
KUNDENPORTAL_SYNC_AKTIV=
# Sync pro Standort (PROJ-12): erst auf "true" setzen, wenn das Kundenportal
# den Parameter standortId kennt (Auftrag docs/kundenportal-auftrag-sync-pro-standort.md).
# Ein älteres Portal würde ihn ignorieren und die ganze Firma übertragen.
# Solange der Wert fehlt, überträgt das Admin-Tool wie bisher die ganze Firma.
KUNDENPORTAL_STANDORT_SYNC_AKTIV=

# PDF-Export Prüfberichte (PROJ-7) — nutzt dieselbe Azure-AD-App-Registrierung
# wie oben (AZURE_CLIENT_ID/_SECRET/_TENANT_ID), zusätzlich muss ihr dort eine
# auf die SharePoint-Bibliothek "Kunden" beschränkte Microsoft-Graph-
# Berechtigung (Sites.Selected) erteilt und freigegeben (Consent) werden,
# siehe PROJ-7-Spec, Technical Requirements.
# Pfad (relativ zur Bibliothek "Kunden") zur zentralen Standard-Vorlage, die
# verwendet wird, wenn eine Firma im aktuellen Jahresordner noch keine eigene
# Excel-Vorlage hat, z.B. "_Standardvorlage/Pruefberichtraport.xlsx".
SHAREPOINT_STANDARD_VORLAGE_PFAD=

# PDF-Export digital signieren (PROJ-9)
# Modus: leer/"aus" = unsigniert wie bisher (Standard), "test" = Phase 1 mit
# selbst erstelltem Test-Zertifikat. "test" wirkt NUR lokal und in Vercel-
# Previews — in Production wird es ignoriert (unsigniert + Warnung im Log).
# Im Testmodus wird das PDF nicht im SharePoint-Archiv abgelegt.
# "produktiv" (echtes Firmen-Siegel) folgt in Phase 2.
PDF_SIGNATUR_MODUS=
# Test-Zertifikat und -Schlüssel (nur .env.local und Vercel "Preview", NIE
# "Production", nie committen). Einmalig erstellen mit:
#   openssl req -x509 -newkey rsa:3072 -nodes -sha256 -days 1095 \
#     -keyout test-schluessel.pem -out test-zertifikat.pem \
#     -subj "/CN=OBSI Hofer GmbH (TEST)/O=OBSI Hofer GmbH (TEST)/C=CH" \
#     -addext "keyUsage=critical,digitalSignature,nonRepudiation"
# Wert: PEM-Inhalt (Zeilenumbrüche auch als "\n" geschrieben erlaubt) oder
# die ganze Datei base64-kodiert, z.B. `base64 -w0 test-zertifikat.pem`.
PDF_SIGNATUR_TEST_ZERTIFIKAT=
PDF_SIGNATUR_TEST_SCHLUESSEL=
# Optional: Zeitstempeldienst (RFC 3161). Standard: https://freetsa.org/tsr
PDF_SIGNATUR_ZEITSTEMPEL_URL=
